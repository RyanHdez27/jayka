# URL del backend
VITE_API_URL=http://localhost:8000

# ─── EMAILJS CONFIGURACIÓN ───
# ID del servicio conectado a Gmail (ej: service_abc123)
VITE_EMAILJS_SERVICE_ID=tu_service_id
# ID de la plantilla para el correo que recibe Jayka (ej: template_xyz456)
VITE_EMAILJS_TEMPLATE_ID=tu_template_id
# Clave pública de EmailJS (Account > Public Key)
VITE_EMAILJS_PUBLIC_KEY=tu_public_key
# ID de la plantilla para la auto-respuesta al cliente (Opcional)
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=tu_template_autoreply_id

# ─── GNEWS API CONFIGURACIÓN ───
VITE_GNEWS_API_KEY=tu_gnews_api_key
